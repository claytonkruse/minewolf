# Minewolf environment template.
# Production (hetzner-arch): copy to ~/minewolf/.env, fill in, then run
#   chmod 600 .env && ./update.sh --force
# These are read at BUILD time ($env/static), so any change needs a rebuild,
# not just a restart.

# --- Database ---------------------------------------------------------------
# Production: docker-compose.yaml builds DB_URL from this password.
# Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Local dev only (production gets DB_URL from docker-compose.yaml):
# DB_URL=postgres://postgres:postgres@localhost:5432/postgres

# --- Cloudflare Turnstile (CAPTCHA) ----------------------------------------
# https://dash.cloudflare.com -> Turnstile -> your site
PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=0x4AAAAAAA...
CLOUDFLARE_TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# --- Discord ----------------------------------------------------------------
# Invite link shown on the site
PUBLIC_DISCORD_INVITE=https://discord.gg/your-invite

# https://discord.com/developers/applications -> your app -> OAuth2
# The redirect URI must also be added under OAuth2 -> Redirects.
PUBLIC_DISCORD_CLIENT_ID=123456789012345678
DISCORD_CLIENT_SECRET=your-client-secret
PUBLIC_DISCORD_OAUTH_REDIRECT_URI=https://minewolf.net/login
